{
  "multipart": [
    { "apply": { "model": "createthrusters:block/universal_display_adaptor/core" } },
    { "when": { "down": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_down" } },
    { "when": { "up": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_up" } },
    { "when": { "north": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_north" } },
    { "when": { "south": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_south" } },
    { "when": { "west": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_west" } },
    { "when": { "east": "true" }, "apply": { "model": "createthrusters:block/universal_display_adaptor/arm_east" } }
  ]
}
